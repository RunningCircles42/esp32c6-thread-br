# Copy to sdkconfig.secrets (git-ignored) and fill in.
# Generate fresh Thread credentials with ./scripts/gen-secrets.sh instead of
# editing these by hand.

# --- Wi-Fi (2.4 GHz only; the ESP32-C6 cannot see 5 GHz networks) ---
CONFIG_EXAMPLE_WIFI_SSID="YOUR_WIFI_NAME"
CONFIG_EXAMPLE_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# --- Thread network credentials (must be random and kept private) ---
CONFIG_OPENTHREAD_NETWORK_NAME="XIAO-Thread"
CONFIG_OPENTHREAD_NETWORK_CHANNEL=25
CONFIG_OPENTHREAD_NETWORK_PANID=0x0000
CONFIG_OPENTHREAD_NETWORK_EXTPANID="0000000000000000"
CONFIG_OPENTHREAD_NETWORK_MASTERKEY="00000000000000000000000000000000"
CONFIG_OPENTHREAD_NETWORK_PSKC="00000000000000000000000000000000"
CONFIG_OPENTHREAD_MESH_LOCAL_PREFIX="fd00:0:0:0::/64"
